# Config para Hostinger (hosting compartido, Apache). Equivalente a
# public/_headers (que solo Netlify interpreta) + HTTPS/caché, que en
# Netlify vienen gratis pero en Apache hay que declararlos a mano.
#
# Antes de confiar en el bloque HSTS de abajo: confirmar en el panel
# de Hostinger que el SSL (Let's Encrypt) está activo y renovándose
# solo. Con HSTS activo y sin HTTPS funcionando, el sitio queda
# inaccesible por http Y por https roto — revisar esto primero.

<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

# Fuerza HTTPS. Si en el panel de Hostinger ya activaste "Force
# HTTPS", esto queda redundante pero no estorba.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Caché de un año SOLO para /assets/ — ahí Vite nombra cada archivo
# con un hash de su contenido (ej. index-aYGUzQKy.js), así que un
# cambio real siempre es un nombre nuevo, nunca el mismo archivo con
# contenido distinto. Por eso va con <If> (acota por URL, no por
# extensión): un filtro por extensión (ej. "*.svg") también agarraría
# a favicon.svg en la raíz, que SÍ cambia de contenido manteniendo el
# mismo nombre — cachearlo un año rompería cualquier actualización
# futura (bug real que pasó: el favicon no se actualizaba porque esta
# regla, antes por extensión, lo estaba cacheando como si fuera
# inmutable).
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
